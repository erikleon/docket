{
  "name": "docket",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop tool for triaging harassing messages and preserving evidence.",
  "author": "docket contributors",
  "homepage": "https://erikleon.github.io/docket/",
  "repository": "https://github.com/erikleon/docket",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p renderer/tsconfig.json && node scripts/copy-ui-assets.mjs",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "tsc -p renderer/tsconfig.json && node scripts/copy-ui-assets.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src test renderer --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.eslint.json --noEmit && tsc -p renderer/tsconfig.json --noEmit",
    "predist": "npm run build",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "pretest": "npm run fetch-assets",
    "prebuild": "npm run fetch-assets",
    "fetch-assets": "node scripts/fetch-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "bplist-creator": "^0.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "better-sqlite3": "^13.0.3",
    "bplist-parser": "^0.5.0",
    "fast-xml-parser": "^5.11.1",
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "minisiwyg-editor": "^0.6.0",
    "onnxruntime-node": "^1.30.0",
    "strictdatetime": "^1.4.0"
  }
}
